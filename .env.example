# SUMS - Variables de Entorno
# Sistema Unidad Médica Suchiapa — IMSS Bienestar
#
# INSTRUCCIONES:
# 1. Copia este archivo como .env.local para desarrollo local
# 2. En producción, configura estas variables en tu servidor/plataforma de despliegue
# 3. NUNCA subas el archivo .env.local o .env.production al repositorio git
#
# Todas las variables expuestas al cliente DEBEN comenzar con VITE_

# ─── API BASE ────────────────────────────────────────────────────────────────
# URL del servidor backend de SUMS
VITE_API_BASE_URL=http://localhost:3000/api/v1

# ─── OCR SERVICE ─────────────────────────────────────────────────────────────
# URL del microservicio de reconocimiento óptico de caracteres
VITE_OCR_API_URL=http://localhost:8000/ocr
VITE_OCR_API_KEY=REPLACE_WITH_REAL_OCR_API_KEY

# ─── AUTENTICACIÓN ────────────────────────────────────────────────────────────
# Clave secreta para firmar tokens JWT (solo backend, no exponer en cliente)
# NOTA: Esta variable NO debe comenzar con VITE_ si es solo del backend
JWT_SECRET=REPLACE_WITH_SECURE_RANDOM_SECRET

# Duración de sesión en segundos (default: 8 horas = 28800)
VITE_SESSION_TIMEOUT=28800

# ─── STORAGE ──────────────────────────────────────────────────────────────────
# URL del servicio de almacenamiento de documentos PDF
VITE_STORAGE_URL=http://localhost:9000

# ─── INSTITUCIÓN ──────────────────────────────────────────────────────────────
# Nombre de la unidad médica (configurable por entorno)
VITE_UNIT_NAME=Unidad Médica Suchiapa
VITE_UNIT_CLUES=CS071400001

# ─── FEATURE FLAGS ────────────────────────────────────────────────────────────
# Activa el modo de demostración con datos mock (true en dev, false en prod)
VITE_DEMO_MODE=true
